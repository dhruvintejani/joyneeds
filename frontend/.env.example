# Storefront/backend API origin.
# Local development defaults to http://localhost:4000 when this is omitted.
# Production deployments must set this to the deployed HTTPS backend origin.
VITE_API_URL=http://localhost:4000

# Phase 4 customer authentication. Leave blank for guest-only mode.
# This is a public Clerk key and is safe for the browser; never put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=

# Razorpay public configuration is added in its payment phase.
