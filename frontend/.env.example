# Storefront/backend API origin.
# Local development defaults to http://localhost:4000 when omitted.
# In production set VITE_API_URL=same-origin to use the Vercel secure API relay.
# Vercel server-side env must also set BACKEND_ORIGIN to the Render HTTPS origin.
# For local development, connect directly to the local backend:
VITE_API_URL=http://localhost:4000

# Vercel ONLY: set this in the project Environment Variables (server-side relay).
# Use the bare HTTPS Render origin; never prefix it with VITE_.
BACKEND_ORIGIN=

# Optional customer authentication. This is Clerk's public browser key.
# Never place CLERK_SECRET_KEY or any other server secret in the frontend env.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk can present Google OAuth after you enable Google in the Clerk dashboard.
# OAuth requires no Google client secret in Vite. Never add a secret to VITE_* variables.
# Configure Clerk's authorized domains and production OAuth credentials in its dashboard.

# Razorpay's public checkout key is returned by the backend per payment order.
# No Razorpay secret belongs in the frontend environment.

# Enable only after backend order creation, payment verification and merchant onboarding are tested.
VITE_CHECKOUT_ENABLED=false

# Only activate once the backend and merchant credentials are tested.
VITE_PAYMENT_PROVIDER=PAYTM

# Public store details (no secrets); defaults preserve existing storefront values.
VITE_SITE_URL=https://joyneeds.vercel.app
VITE_SUPPORT_EMAIL=
VITE_BUSINESS_EMAIL=
VITE_SUPPORT_PHONE=
VITE_BUSINESS_ADDRESS=
VITE_LEGAL_ENTITY_NAME=
VITE_SHIPPING_TIMELINES=
VITE_SHIPPING_COVERAGE=
VITE_RETURN_WINDOW=
VITE_REFUND_TIMELINE=
VITE_CANCELLATION_WINDOW=
# Review the real catalog and policies before changing these flags.
VITE_CATALOG_VERIFIED=false
VITE_POLICIES_VERIFIED=false

# Optional display estimate in paise; backend SHIPPING_FEE_PAISE is authoritative.
VITE_SHIPPING_FEE_PAISE=
