# Storefront/backend API origin.
# Local development defaults to http://localhost:4000 when omitted.
# Production deployments must set this to the deployed HTTPS backend origin.
VITE_API_URL=http://localhost:4000

# Optional customer authentication. This is Clerk's public browser key.
# Never place CLERK_SECRET_KEY or any other server secret in the frontend env.
VITE_CLERK_PUBLISHABLE_KEY=

# Razorpay's public checkout key is returned by the backend per payment order.
# No Razorpay secret belongs in the frontend environment.
