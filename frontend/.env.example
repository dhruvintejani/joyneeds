# Storefront/backend API origin.
# Local development defaults to http://localhost:4000 when omitted.
# Production deployments must set this to the deployed HTTPS backend origin.
VITE_API_URL=http://localhost:4000

# Optional customer authentication. This is Clerk's public browser key.
# Never place CLERK_SECRET_KEY or any other server secret in the frontend env.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk can present Google OAuth after you enable Google in the Clerk dashboard.
# OAuth requires no Google client secret in Vite. Never add a secret to VITE_* variables.
# Configure Clerk's authorized domains and production OAuth credentials in its dashboard.

# Razorpay's public checkout key is returned by the backend per payment order.
# No Razorpay secret belongs in the frontend environment.

# Enable only after backend order creation, payment verification and merchant onboarding are tested.
VITE_CHECKOUT_ENABLED=false

# Only activate once the backend and merchant credentials are tested.
VITE_PAYMENT_PROVIDER=PAYTM
