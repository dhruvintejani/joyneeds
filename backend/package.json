{
  "name": "@joyneeds/backend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npm run prisma:generate && prisma db seed",
    "db:studio": "prisma studio",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run prisma:generate && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@clerk/express": "2.1.66",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.15.6",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
