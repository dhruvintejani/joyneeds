NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Runtime connection. For Neon, prefer the pooled connection string here.
DATABASE_URL=

# Optional but recommended for Prisma CLI/migrations on Neon: use the direct connection string.
DIRECT_URL=

# Phase 4 customer authentication. Leave both blank to run JoyNeeds in guest-only mode.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin authentication is intentionally separate from Clerk and is added in Phase 5.
