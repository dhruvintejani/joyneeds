NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Runtime connection. For Neon, prefer the pooled connection string here.
DATABASE_URL=

# Optional but recommended for Prisma CLI/migrations on Neon: use the direct connection string.
DIRECT_URL=

# Clerk backend authentication. Leave all three blank until your JoyNeeds Clerk app is created.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user IDs allowed to access /api/admin/*.
# Example: user_abc123,user_def456
ADMIN_CLERK_USER_IDS=
