NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Runtime connection. For Neon, prefer the pooled connection string here.
DATABASE_URL=

# Optional but recommended for Prisma CLI/migrations on Neon: use the direct connection string.
DIRECT_URL=

# Customer authentication. Leave both blank to run JoyNeeds in guest-only mode.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Use the SAME Clerk instance as VITE_CLERK_PUBLISHABLE_KEY on the frontend.
# Enable email sign-in and Google OAuth in the Clerk dashboard.
# Google OAuth production consent/scope and domain setup happen outside env files.

# Separate single-admin authentication. Never store a plaintext password here.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=12

# Keep false until the selected provider is configured and tested in a non-production environment.
ORDER_CREATION_ENABLED=false

# Product images. Configure all three together; keep the API secret backend-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=joyneeds/products

# Payments. Configure all three together. Never expose KEY_SECRET or WEBHOOK_SECRET to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email. The sender email must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JoyNeeds
BREVO_REPLY_TO_EMAIL=

# Select PAYTM or RAZORPAY; match the frontend VITE_PAYMENT_PROVIDER.
# Paytm UPI/payment gateway. No live charges without merchant onboarding.
PAYMENT_PROVIDER=PAYTM
PAYTM_ENV=staging
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=
PAYTM_CALLBACK_URL=

# Fixed inbox for storefront enquiries (requires configured Brevo sender/API key).
CONTACT_RECIPIENT_EMAIL=

# Flat shipping charge in integer paise (0 means free). Set the actual approved charge.
SHIPPING_FEE_PAISE=0
